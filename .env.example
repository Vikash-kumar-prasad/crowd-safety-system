# ============================================================
# Crowd Safety System — Environment Configuration
# ============================================================
# Copy this file to .env and adjust values as needed.
# All variables are optional and have sensible defaults.

# Video source: camera index (0, 1, ...) or path to a video file
VIDEO_SOURCE=0

# Server binding
HOST=0.0.0.0
PORT=5000

# Model paths (relative to project root or absolute)
HEAD_MODEL=models/best.pt
WEAPON_MODEL=models/best_weapon_v4.pt

# Detection confidence thresholds (0.0 - 1.0)
HEAD_CONF=0.3
WEAPON_CONF=0.48

# Demo mode: set to "true" to enable fallback when no camera is available
DEMO_MODE=false

# Emergency Dispatch — Optional Telegram Bot Integration
# TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# TELEGRAM_CHAT_ID=your_telegram_chat_id_here

